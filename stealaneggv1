local urls = {
    "https://flowauth.net/v1/ui/145ed15b0322d52d97675f0d16f3278c.lua",
    "https://flowauth.net/v1/ui/b8430d6840e6214c130365e4e8033124.lua"
}

for i, url in ipairs(urls) do
    local ok, result = pcall(function()
        local source = game:HttpGet(url)
        assert(source and #source > 0, "Không tải được mã")
        local fn = assert(loadstring(source))
        return fn()
    end)

    if not ok then
        warn("Lỗi script " .. i .. ": " .. tostring(result))
    end
end
